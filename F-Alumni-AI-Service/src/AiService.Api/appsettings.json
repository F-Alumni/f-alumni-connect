{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FAlumni_AI_Db;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "https://identity.falumni.local",
    "Audience": "falumni-services",
    "Key": "falumni-production-shared-jwt-secret-key-2026-min-32-bytes",
    "ClockSkewMinutes": 1
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash"
  },
  "Rag": {
    "DataDirectory": "data/rag",
    "MaxCitations": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "PostCreatedTopic": "post.created.v1",
    "ConsumerGroup": "falumni-ai-service.post-created-group",
    "Enabled": true
  }
}
