      <mxCell id="d05_communication_c25" value="&lt;b&gt;[4] Async Consume&lt;/b&gt;&lt;br/&gt;(post.created.v1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=0;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;" vertex="1" parent="1">
        <mxGeometry x="1275" y="477" width="166" height="42" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c26" value="&lt;b&gt;Chú thích ký hiệu đường truyền:&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1">
        <mxGeometry x="70" y="382" width="350" height="172" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1">
