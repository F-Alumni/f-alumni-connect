      <mxCell id="d13_realtime_signalr_c14" value="&lt;b&gt;ChatHub &amp;amp; ChatAppService&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
