      <mxCell id="d05_communication_c38" value="&lt;b&gt;1. REST / HTTP JSON&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Đồng bộ)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="40" y="646" width="340" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c39" value="• Client ↔ YARP Gateway (:5000 /api/v1/*) tới cả 6 microservice (gồm NotificationService :5006).&lt;br/&gt;• AdminService → UserService (&lt;b&gt;UserServiceClient&lt;/b&gt; gọi /api/v1/internal/users/{id}/suspend)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="380" y="646" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c40" value="Chuẩn phổ biến cho thao tác CRUD từ Web/Mobile, dễ kiểm thử với Swagger &amp;amp; chuẩn lỗi RFC 7807." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="1130" y="646" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c41" value="&lt;b&gt;2. SignalR WebSocket&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Realtime 2 chiều)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="40" y="726" width="340" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c42" value="• Web/Mobile ↔ ChatService (&lt;b&gt;ChatHub&lt;/b&gt; /hubs/chat), ForumService (&lt;b&gt;ForumHub&lt;/b&gt; /hubs/forum) &amp;amp; &lt;b&gt;NotificationHub&lt;/b&gt; (/hubs/notifications)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="380" y="726" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c43" value="Push dữ liệu tức thì (typing, tin nhắn mới, thông báo realtime, đã xem) mà không tốn request HTTP polling." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="1130" y="726" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c44" value="&lt;b&gt;3. gRPC HTTP/2&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Đồng bộ, nhị phân)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="40" y="806" width="340" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c45" value="• ChatService (&lt;b&gt;UserProfileLookupService&lt;/b&gt;) → UserService (:50051 · &lt;b&gt;UserProfileGrpcService.GetUserSummary&lt;/b&gt;)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="380" y="806" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c46" value="Đóng gói nhị phân Protobuf trên HTTP/2 nhỏ gọn và nhanh hơn JSON, hợp đồng .proto chặt chẽ giữa các service." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="1130" y="806" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c47" value="&lt;b&gt;4. Apache Kafka&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Bất đồng bộ, Event)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="40" y="886" width="340" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c48" value="• Forum → AI (&lt;b&gt;post.created.v1&lt;/b&gt;); Forum → Admin (&lt;b&gt;forum.report_created.v1&lt;/b&gt;).&lt;br/&gt;• Chat/Forum → Notification (&lt;b&gt;chat.message_sent.v1&lt;/b&gt;, &lt;b&gt;forum.comment_created.v1&lt;/b&gt;, &lt;b&gt;forum.post_reacted.v1&lt;/b&gt;)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="380" y="886" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c49" value="Tách rời tải xử lý (decoupling): đăng bài/báo cáo trả về ngay; RAG/Gemini 2.5, thông báo và kiểm duyệt chạy nền không mất sự kiện." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Arial;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="1130" y="886" width="750" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="d05_communication_c50" value="&lt;b&gt;Kết luận:&lt;/b&gt; Hình này chứng minh FPT Alumni Connect áp dụng đúng từng giao thức theo bài toán — REST cho CRUD, SignalR cho realtime 2 chiều, gRPC cho tốc độ nội bộ và Kafka để tách tải bất đồng bộ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
        <mxGeometry x="40" y="990" width="1840" height="64" as="geometry"/>
      </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
